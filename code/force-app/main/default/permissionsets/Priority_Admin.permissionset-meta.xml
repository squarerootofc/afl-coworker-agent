<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Priority Admin</label>
    <description>For the driver and admins only. Full access to account priorities so the seed scripts, Apex tests and teardown can run. New fields get no field-level security by default, and anonymous Apex and WITH USER_MODE both enforce it. Never assign to sellers.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <object>Account_Priority__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Account__c is required, so it is always editable and can't be listed here. -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Account_Priority__c.Priority_Rank__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account_Priority__c.Priority_Reason__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account_Priority__c.Recommended_Action__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account_Priority__c.Refreshed_On__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account_Priority__c.Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account_Priority__c.Actioned_On__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account_Priority__c.Action_Record_Id__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account_Priority__c.Signal_Type__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account_Priority__c.Propensity_Score__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account_Priority__c.Estimated_Value__c</field>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
